# Node modules (always ignore this)
node_modules/

# Build output (compiled JavaScript files)
dist/
build/

# TypeScript cache
*.tsbuildinfo

# Environment variables (never commit secrets)
# .env  leave this commented out
.env.local
.env.development
.env.production
.env.test

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-error.log*
lerna-debug.log*
*.log

# Editor files (VSCode, JetBrains, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-specific files
.DS_Store
Thumbs.db

# Testing & coverage
coverage/
.jest/
.nyc_output/
